digraph star_seed_acquisition {
graph [rankdir=TB, splines=polyline, overlap=false, nodesep=0.20, ranksep=0.34, pad=0.18, margin=0.04, bgcolor="white", fontname="DejaVu Sans", fontsize=17, labelloc="t", label="Closed-loop automatic acquisition of six star-shaped seed poses\nOne stationary reference + five adaptive rotation branches (before NBV)", compound=true, newrank=true];
node [shape=box, style="rounded,filled", fillcolor="#F7FAFC", color="#4A6075", penwidth=1.25, fontname="DejaVu Sans", fontsize=10, margin="0.12,0.07"] ;
edge [color="#43576A", penwidth=1.25, arrowsize=0.72, fontname="DejaVu Sans", fontsize=9, fontcolor="#334E68"] ;
subgraph cluster_init {
label="I  Guided initialization"; color="#90B8D8"; penwidth=1.5; style="rounded"; bgcolor="#F5FAFE"; fontname="DejaVu Sans"; fontsize=13;
start [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Start</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Manual intervention is confined to initial alignment</FONT></TD></TR></TABLE>>, shape="oval", fillcolor="#DCEEFF", color="#2F6F9F"];
manual [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Set the reference observation</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Move the target-surface chord into the guide ROI</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">and close to the desired 80-mm reference line</FONT></TD></TR></TABLE>>, shape="parallelogram", fillcolor="#FFF4D6", color="#B88214"];
align [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Stable valid dual-edge observation?</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Both breakpoints visible; robot stationary</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">and initial working envelope satisfied</FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#FFF9E8", color="#B88214", margin="0.08,0.04"];
detect [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Lock the two physical breakpoints</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">ROI breakpoint detection and ordered assignment</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Initialize two local CSRT trackers</FONT></TD></TR></TABLE>>, fillcolor="#E8F3FB", color="#3976A8"];
refcap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Capture the stationary reference seed</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Target 18 frames; endpoint MAD rejection</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">At least 14 synchronized inlier frames</FONT></TD></TR></TABLE>>, fillcolor="#E9F7EF", color="#2E7D57"];
refok [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Reference batch valid?</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Safe pair, synchronized pose, sufficient inliers</FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#F0F8F4", color="#2E7D57", margin="0.08,0.04"];
track [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Enter seed-tracking mode</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Preserve endpoint_u / endpoint_v identity</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Store the last verified safe pose</FONT></TD></TR></TABLE>>, fillcolor="#E8F3FB", color="#3976A8"];
probe [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>One-time 3-axis translation probe</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">ΔS=[Δs_x  Δs_y  Δs_z]</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">ΔQ=[Δq_x  Δq_y  Δq_z]</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">J⁰=ΔS·ΔQ⁺ ∈ ℝ²ˣ³</FONT></TD></TR></TABLE>>, fillcolor="#EDE9FA", color="#6554A3"];
preflight_note [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#7A5A00"><B>Optional preflight</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Measured ±X/±Y preflight is optional; this run used mode=off and skipped it.</FONT></TD></TR></TABLE>>, shape="note", style="filled,dashed", fillcolor="#FFFBEA", color="#C49A2C"];
}
subgraph cluster_loop {
label="II  Adaptive star-branch loop"; color="#A7C9A8"; penwidth=1.5; style="rounded"; bgcolor="#F8FCF8"; fontname="DejaVu Sans"; fontsize=13;
branches [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Initialize the star-branch queue</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Nominal order: R_y(+), R_y(-), R_x(+),</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">R_x(-), R_xR_y(+)</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Non-parallel fallback branches if required</FONT></TD></TR></TABLE>>, fillcolor="#EDF6ED", color="#4D8A50"];
return [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Return to the verified reference</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Staged joint return + bounded-template reacquisition</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Reset branch angle, step and feed-forward model</FONT></TD></TR></TABLE>>, fillcolor="#F1F6F9", color="#607D8B"];
select [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Select the next rotation branch</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Local flange axis; 10° target</FONT></TD></TR></TABLE>>, fillcolor="#EDF6ED", color="#4D8A50"];
rotate [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Execute one orientation micro-step</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Start at Δθ=1°; accelerate to 2° after verification</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Add learned local-translation feed-forward</FONT></TD></TR></TABLE>>, fillcolor="#EDE9FA", color="#6554A3"];
measure [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Settle and read synchronized feedback</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Track both breakpoints; extract s=[x_mid,L]ᵀ</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">L is the intended physical-breakpoint separation</FONT></TD></TR></TABLE>>, fillcolor="#E8F3FB", color="#3976A8"];
hard [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Intended edge pair inside hard guard?</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Safe observation and continuous identities</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">50 mm ≤ L ≤ 120 mm</FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#FFF4ED", color="#B85C32", margin="0.08,0.04"];
rollback [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Protective recovery</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Rollback to last valid pose; reduce Δθ</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Discard unsafe feed-forward and reacquire</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Repeated failure: reference recovery / fallback branch</FONT></TD></TR></TABLE>>, fillcolor="#FDEDEC", color="#B5483B", style="rounded,filled,dashed"];
update [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Update measured local models</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Update rotation-induced feature-drift rate</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Accumulate achieved rotation</FONT></TD></TR></TABLE>>, fillcolor="#EDE9FA", color="#6554A3"];
soft [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Dual feature inside servo target band?</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">|x_mid| ≤ 10 mm</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">70 mm ≤ L ≤ 90 mm</FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#FFF9E8", color="#B88214", margin="0.08,0.04"];
servo [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Closed-loop local translation</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">e=[e_x,e_L]ᵀ</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Δq_F=−kJᵀ(JJᵀ+λ²I)⁻¹e</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Accepted measured motions update J by Broyden</FONT></TD></TR></TABLE>>, fillcolor="#FFF4D6", color="#B88214"];
angle [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Branch target reached?</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Accumulated rotation ≥ 10°</FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#F0F8F4", color="#2E7D57", margin="0.08,0.04"];
capture [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Capture the stationary branch seed</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">18 synchronized frames; endpoint MAD filtering</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Check rotational diversity</FONT></TD></TR></TABLE>>, fillcolor="#E9F7EF", color="#2E7D57"];
capok [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>≥14 inliers and diverse pose?</B></FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#F0F8F4", color="#2E7D57", margin="0.08,0.04"];
reject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Reject this branch sample</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Return to reference and try a fallback branch</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">A safe partial orientation may be retained as fallback</FONT></TD></TR></TABLE>>, fillcolor="#FDEDEC", color="#B5483B", style="rounded,filled,dashed"];
accept [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Accept one physical seed pose</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Store T_BF, surface profile and endpoints per inlier</FONT></TD></TR></TABLE>>, fillcolor="#DFF3E8", color="#2E7D57"];
all [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Six physical seeds collected?</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Reference + five valid branches</FONT></TD></TR></TABLE>>, shape="diamond", fillcolor="#EAF4F8", color="#3976A8", margin="0.08,0.04"];
formula [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#4D3C86"><B>Dual feature and dead-band error</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">s=[x<SUB>mid</SUB>, L]<SUP>T</SUP>, &nbsp; s<SUP>*</SUP>=[0,80 mm]<SUP>T</SUP></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">e<SUB>x</SUB>=0 if |x<SUB>mid</SUB>|≤10 mm; otherwise e<SUB>x</SUB>=x<SUB>mid</SUB></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">e<SUB>L</SUB>=0 if 70≤L≤90 mm; otherwise e<SUB>L</SUB>=L−80 mm</FONT></TD></TR></TABLE>>, shape="note", fillcolor="#F5F2FD", color="#7B68B3"];
}
subgraph cluster_out {
label="III  Output and downstream handoff"; color="#A9B7C4"; penwidth=1.5; style="rounded"; bgcolor="#FAFBFC"; fontname="DejaVu Sans"; fontsize=13;
save [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Write seeds.json</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">This run: 6 physical poses, 98 synchronized inliers</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Stop seed-stage breakpoint tracking</FONT></TD></TR></TABLE>>, shape="cylinder", fillcolor="#E8F3FB", color="#3976A8"];
handoff [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Joint six-seed initialization</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Shared 12-DOF-V2 initialization</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">NBV starts afterward (outside this figure)</FONT></TD></TR></TABLE>>, shape="oval", fillcolor="#EDE9FA", color="#6554A3"];
evidence [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="CENTER"><FONT COLOR="#17365D"><B>Evidence from the selected real run</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Observed order: reference → R_y(+)  → R_y(-) → R_x(+) → R_x(-) → R_xR_y(+)</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Inlier frames per pose: [18, 16, 14, 14, 18, 18]; total 98</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">Branches with rollback: R_y(-), R_xR_y(+)</FONT></TD></TR></TABLE>>, shape="note", fillcolor="#F7FAFC", color="#7890A4"];
}
start -> manual;
manual -> align;
align -> detect [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
align -> manual [label="No: readjust", color="#B5483B", fontcolor="#B5483B"];
detect -> refcap;
refcap -> refok;
refok -> track [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
refok -> manual [label="No: realign/recapture", color="#B5483B", fontcolor="#B5483B"];
refok -> preflight_note [style="dashed", arrowhead="none", color="#C49A2C"];
track -> probe;
probe -> branches;
branches -> return;
return -> select;
select -> rotate;
rotate -> measure;
measure -> hard;
hard -> update [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
hard -> rollback [label="No", color="#B5483B", fontcolor="#B5483B"];
rollback -> rotate [label="Recovered", color="#B5483B", fontcolor="#B5483B"];
rollback -> reject [label="Repeated failure", style="dashed", color="#B5483B", fontcolor="#B5483B"];
update -> soft;
soft -> angle [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
soft -> servo [label="No", color="#B88214", fontcolor="#9B6E0B"];
servo -> measure [label="Settle and remeasure", color="#B88214", fontcolor="#9B6E0B"];
soft -> formula [style="dashed", arrowhead="none", color="#7B68B3"];
angle -> rotate [label="No", color="#3976A8", fontcolor="#3976A8"];
angle -> capture [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
capture -> capok;
capok -> accept [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
capok -> reject [label="No", color="#B5483B", fontcolor="#B5483B"];
reject -> return [color="#B5483B"];
accept -> all;
all -> return [label="No: next branch", color="#3976A8", fontcolor="#3976A8"];
all -> save [label="Yes", color="#2E7D57", fontcolor="#2E7D57"];
save -> handoff;
save -> evidence [style="dashed", arrowhead="none", color="#7890A4"];
{rank=same; refok; preflight_note;}
{rank=same; hard; rollback;}
{rank=same; soft; formula;}
{rank=same; save; evidence;}
}
