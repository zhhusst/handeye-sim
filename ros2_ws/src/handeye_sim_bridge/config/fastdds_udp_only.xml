<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!--
    The browser simulation runs many ROS 2 processes in one container.
    UDP-only transport avoids stale Fast DDS shared-memory port locks after
    repeated simulation restarts.  All traffic remains local to ROS_DOMAIN_ID.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
