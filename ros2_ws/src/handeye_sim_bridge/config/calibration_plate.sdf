<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="calibration_plate">
    <static>true</static>
    <link name="plate_link">
      <!-- 仅作为材质/结构模板；start_simulation.sh 会按 calibration.yaml 生成本次运行的位姿和尺寸。 -->
      <pose>0.775 0.1 0.245 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.15 0.20 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.6 0.9 0.6</ambient>
          <diffuse>0.3 0.6 0.9 0.6</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.15 0.20 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
