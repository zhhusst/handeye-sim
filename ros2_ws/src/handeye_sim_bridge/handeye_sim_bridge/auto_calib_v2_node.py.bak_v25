#!/usr/bin/env python3
"""auto_calib_v2_node.py v25 — GT verification: Phase 0 + joint-space perturbations.
Strategy: Phase 0 anchors + XY offset → estimate n_B. Then Phase 1/2 use joint-space
perturbations from anchor to get diverse sensor angles while staying near the board.
All transforms use gocator_sensor TF (R_he_true)."""

import rclpy, numpy as np, sys, json
from rclpy.node import Node
from sensor_msgs.msg import PointCloud2, JointState
from tf2_ros import Buffer, TransformListener

sys.path.insert(0, '/workspace/common')
from fov_geometry import so3_exp, so3_log, rodrigues, rpy_to_matrix
from handeye_sim_bridge.fanuc_kinematic import inverse_kinematics_numeric

N_B_GT = np.array([0., 0., 1.])
U_B_GT = np.array([1., 0., 0.])
V_B_GT = np.array([0., 1., 0.])


def ros_tf_to_matrix(t):
    q = t.transform.rotation
    x, y, z, w = q.x, q.y, q.z, q.w
    R = np.array([
        [1-2*(y*y+z*z), 2*(x*y-z*w), 2*(x*z+y*w)],
        [2*(x*y+z*w), 1-2*(x*x+z*z), 2*(y*z-x*w)],
        [2*(x*z-y*w), 2*(y*z+x*w), 1-2*(x*x+y*y)]
    ])
    t_vec = np.array([t.transform.translation.x, t.transform.translation.y, t.transform.translation.z])
    return R, t_vec


def detect_corners(pts, gap=0.02):
    if pts is None or len(pts) < 5:
        return None, None, False
    si = np.argsort(pts[:, 0])
    xs, zs = pts[si, 0], pts[si, 2]
    bi = np.where(np.diff(xs) > gap)[0]
    if len(bi) == 0:
        return (float(xs[0]), float(zs[0])), (float(xs[-1]), float(zs[-1])), False
    segs = []
    s = 0
    for b in bi:
        segs.append((s, b))
        s = b + 1
    segs.append((s, len(xs)-1))
    mi = np.argmax([e-s+1 for s, e in segs])
    ms, me = segs[mi]
    return (float(xs[ms]), float(zs[ms])), (float(xs[me]), float(zs[me])), len(bi) >= 2


def fit_line_3d(pts):
    if len(pts) < 2:
        return None, None
    p = np.array(pts)
    c = np.mean(p, axis=0)
    _, _, vh = np.linalg.svd(p - c, full_matrices=False)
    return vh[0], c


def angle_between(a, b):
    a = np.asarray(a) / np.linalg.norm(a)
    b = np.asarray(b) / np.linalg.norm(b)
    return np.rad2deg(np.arccos(np.clip(abs(np.dot(a, b)), -1, 1)))


class AutoCalibV2Node(Node):
    def __init__(self):
        super().__init__('auto_calib_v2_node')
        self.R_he_gt = rpy_to_matrix(27.8, 9.2, -86.5)
        self.t_he_gt = np.array([-0.011579, -0.004621, 0.359284])
        rng = np.random.RandomState(12345)
        ax = rng.randn(3); ax /= np.linalg.norm(ax)
        R_perturb = so3_exp(ax * rng.normal(0, np.deg2rad(5)))
        self.R_he_nom = R_perturb @ self.R_he_gt
        self.t_he_nom = self.t_he_gt + rng.randn(3) * 0.005
        self.get_logger().info(
            f'R_he_nom err={np.rad2deg(np.linalg.norm(so3_log(self.R_he_nom.T @ self.R_he_gt))):.1f}deg '
            f't_err={np.linalg.norm(self.t_he_nom - self.t_he_gt)*1000:.1f}mm')

        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)

        self.create_subscription(PointCloud2, '/gocator/profile', self._pc_cb, 1)
        self.create_subscription(JointState, '/joint_states', self._js_cb, 1)
        self.latest_profile = None
        self.latest_joints = None

        from control_msgs.action import FollowJointTrajectory
        from rclpy.action import ActionClient
        self._traj_client = ActionClient(
            self, FollowJointTrajectory,
            '/joint_trajectory_controller/follow_joint_trajectory')

        self.records = []
        self._auto_mode = False
        self._auto_queue = []
        self._state = 'IDLE'
        self._scan_wait = 0

        self._pl_state = 'IDLE'
        self._pl_step = 0
        self._pl_steps = []

        self._anchor_joints = None
        self._R_BS_anchor = None
        self._t_BS_anchor = None
        self.R_he_true = None
        self.t_he_true = None

        self.n_B_est = None
        self.u_B_est = None
        self.v_B_est = None

        self.create_timer(0.2, self._state_machine)
        self.get_logger().info("v25 GT-mode — joint-space perturbations")

    def _pc_cb(self, msg):
        from sensor_msgs_py.point_cloud2 import read_points
        try:
            pts = [list(p) for p in read_points(msg, field_names=('x', 'y', 'z'), skip_nans=True)]
            self.latest_profile = np.array(pts, dtype=np.float64) if pts else None
        except Exception:
            pass

    def _js_cb(self, msg):
        JN = ['J1_joint', 'J2_joint', 'J3_joint', 'J4_joint', 'J5_joint', 'J6_joint']
        try:
            self.latest_joints = np.array(
                [msg.position[msg.name.index(j)] for j in JN])
        except Exception:
            pass

    def _get_hand_pose(self):
        try:
            return self.tf_buffer.lookup_transform('world', 'fanuc_flange', rclpy.time.Time())
        except Exception:
            return None

    def _get_sensor_pose_tf(self):
        try:
            tf = self.tf_buffer.lookup_transform('world', 'gocator_sensor', rclpy.time.Time())
            return ros_tf_to_matrix(tf)
        except Exception:
            tf = self._get_hand_pose()
            if tf is None:
                return None, None
            R_BH, t_BH = ros_tf_to_matrix(tf)
            return R_BH @ self.R_he_nom, t_BH + R_BH @ self.t_he_nom

    def _extract_features(self):
        if self.latest_profile is None or len(self.latest_profile) < 3:
            return {'n_pts': 0, 'e1': None, 'e2': None, 'has_corner': False, 'pts_S': np.array([])}
        pts = self.latest_profile
        e1, e2, h2 = detect_corners(pts)
        return {'n_pts': len(pts), 'e1': e1, 'e2': e2, 'has_corner': h2, 'pts_S': pts}

    def _send_joint_target(self, joints, label=''):
        from control_msgs.action import FollowJointTrajectory
        from trajectory_msgs.msg import JointTrajectoryPoint
        from builtin_interfaces.msg import Duration
        goal = FollowJointTrajectory.Goal()
        goal.trajectory.joint_names = [
            'J1_joint', 'J2_joint', 'J3_joint', 'J4_joint', 'J5_joint', 'J6_joint']
        pt = JointTrajectoryPoint()
        pt.positions = [float(v) for v in joints]
        pt.time_from_start = Duration(sec=2, nanosec=0)
        goal.trajectory.points = [pt]
        self._state = 'MOVING'
        self._traj_client.wait_for_server(timeout_sec=1.0)
        self._traj_client.send_goal_async(goal).add_done_callback(self._goal_response_cb)

    def _goal_response_cb(self, f):
        h = f.result()
        if not h.accepted:
            self.get_logger().warn('goal rejected')
            self._state = 'IDLE'
            return
        h.get_result_async().add_done_callback(lambda _: setattr(self, '_state', 'WAIT'))

    def _move_to_pose(self, R_BH, t_BH, label=''):
        Tt = np.eye(4)
        Tt[:3, :3] = R_BH
        Tt[:3, 3] = t_BH
        qs = inverse_kinematics_numeric(Tt, q_init=self.latest_joints)
        if len(qs) == 0:
            self.get_logger().warn(f'  IK FAIL: {label}')
            return False
        self._auto_queue.append((label, qs[0]))
        return True

    def _record_pose(self, f):
        T = self._get_hand_pose()
        if T is None:
            return
        R_BH, t_BH = ros_tf_to_matrix(T)
        R_BS, t_BS = self._get_sensor_pose_tf()
        rec = {'R_BH': R_BH, 't_BH': t_BH, 'R_BS': R_BS, 't_BS': t_BS,
               'n_pts': f['n_pts']}
        if f.get('e1'):
            rec['p_S_e1'] = np.array([f['e1'][0], 0.0, f['e1'][1]])
            rec['valid_e1'] = True
        else:
            rec['valid_e1'] = False
        if f.get('e2'):
            rec['p_S_e2'] = np.array([f['e2'][0], 0.0, f['e2'][1]])
            rec['valid_e2'] = True
        else:
            rec['valid_e2'] = False
        rec['pts_S'] = np.array(f.get('pts_S', []))
        self.records.append(rec)

    def _state_machine(self):
        if not hasattr(self, '_auto_phase'):
            return
        if self._state == 'IDLE' and self._auto_queue:
            label, joints = self._auto_queue.pop(0)
            self.get_logger().info(f'  -> {label}')
            self._send_joint_target(joints, label)
        if self._state == 'WAIT':
            self._scan_wait += 1
            if self._scan_wait >= 6:
                self._state = 'IDLE'
                self._scan_wait = 0
                self._on_move_done()
        if self._state == 'IDLE' and not self._auto_queue and self._pl_state not in ('IDLE', 'DONE'):
            self._pl_next()

    def _on_move_done(self):
        f = self._extract_features()
        if f and f['n_pts'] >= 5:
            self._record_pose(f)
        else:
            self.get_logger().warn(f'  no pts: n_pts={f["n_pts"] if f else 0}')
        self._pl_step += 1
        self._pl_next()

    def _auto_start_once(self):
        if self._auto_mode:
            return
        self._auto_mode = True
        if self.latest_profile is None or len(self.latest_profile) < 5:
            self._auto_mode = False
            self.get_logger().info('--auto: waiting for profile...')
            if hasattr(self, '_ar_timer') and self._ar_timer:
                self._ar_timer.cancel()
            self._ar_timer = self.create_timer(1.0, self._auto_start_once)
            return
        self._delayed_timer = self.create_timer(1.0, self._pipeline_start)

    # ========================================================================
    # PIPELINE
    # ========================================================================

    def _pipeline_start(self):
        self.destroy_timer(self._delayed_timer)
        self.get_logger().info('\n' + '=' * 50 + '\n  v25 GT-mode Pipeline\n' + '=' * 50)
        self._auto_phase = 'PIPELINE'

        R_BS_a, t_BS_a = self._get_sensor_pose_tf()
        if R_BS_a is None:
            self.get_logger().error('no sensor TF')
            return
        ht = self._get_hand_pose()
        if ht is None:
            self.get_logger().error('no hand TF')
            return
        R_BH_a, t_BH_a = ros_tf_to_matrix(ht)
        self.R_he_true = R_BH_a.T @ R_BS_a
        self.t_he_true = R_BH_a.T @ (t_BS_a - t_BH_a)
        self._R_BS_anchor = R_BS_a
        self._t_BS_anchor = t_BS_a
        self._anchor_joints = self.latest_joints.copy() if self.latest_joints is not None else None

        err_R = np.rad2deg(np.linalg.norm(so3_log(self.R_he_true.T @ self.R_he_gt)))
        err_t = np.linalg.norm(self.t_he_true - self.t_he_gt) * 1000
        self.get_logger().info(
            f'  R_he_true: R_err vs GT={err_R:.2f}deg t_err={err_t:.2f}mm')
        if self._anchor_joints is not None:
            self.get_logger().info(
                f'  Anchor joints: [{", ".join(f"{j:.3f}" for j in self._anchor_joints)}]')

        f = self._extract_features()
        if not f or f['n_pts'] < 5:
            self.get_logger().error('no profile at anchor')
            return
        self._record_pose(f)  # frame 0: anchor

        # Phase 0: 3 rotation groups × 3 poses = 9 poses
        # Each group uses identical hand orientation, varying only translation
        self.get_logger().info('\n' + '-' * 50 + '\n  Phase 0: Xu closed-form (3 groups × 3 poses)\n' + '-' * 50)

        from fov_geometry import rodrigues as rod
        J0 = self._anchor_joints.copy()

        # Group A: anchor orientation, X translations
        # Group B: J5-like rotation (~9°), X translations
        # Group C: negative J5-like rotation (~-9°), X translations
        R_BH_B = R_BH_a @ rod(np.array([0., 1., 0.]), np.deg2rad(9))
        R_BH_C = R_BH_a @ rod(np.array([0., 1., 0.]), np.deg2rad(-9))
        t_base = t_BH_a.copy()

        phase0_targets = [
            # Group A
            (R_BH_a, t_base + np.array([0.05, 0., 0.]), 'A: X+50'),
            (R_BH_a, t_base + np.array([-0.03, 0., 0.]), 'A: X-30'),
            # Group B
            (R_BH_B, t_base + np.array([0., 0.03, 0.]), 'B: baseline'),
            (R_BH_B, t_base + np.array([0., -0.03, 0.]), 'B: Y-30'),
            (R_BH_B, t_base + np.array([0.05, 0.03, 0.]), 'B: X+50'),
            # Group C
            (R_BH_C, t_base + np.array([0., 0.03, 0.]), 'C: baseline'),
            (R_BH_C, t_base + np.array([0., -0.03, 0.]), 'C: Y-30'),
            (R_BH_C, t_base + np.array([0.05, 0.03, 0.]), 'C: X+50'),
        ]

        # Filter to IK-feasible poses
        self._phase0_groups = {'A': [], 'B': [], 'C': []}
        self._pl_steps = []
        group_iter = iter(['A','A','B','B','B','C','C','C'])
        for R, t, label in phase0_targets:
            g = next(group_iter)
            qs = inverse_kinematics_numeric(
                np.vstack([np.hstack([R, t.reshape(3,1)]), [[0,0,0,1]]]), q_init=J0)
            if len(qs) > 0:
                self._pl_steps.append((R, t, label))
                self._phase0_groups[g].append(len(self._pl_steps) - 1)  # index in records
            else:
                self.get_logger().warn(f'  IK fail: {label} (group {g})')

        self.get_logger().info(
            f'  Phase 0 targets: {len(self._pl_steps)} poses '
            f'(A={len(self._phase0_groups["A"])} B={len(self._phase0_groups["B"])} '
            f'C={len(self._phase0_groups["C"])})')
        self._pl_step = 0
        self._pl_state = 'PHASE0_MOVE'

    def _pl_next(self):
        if self._pl_state == 'PHASE0_MOVE':
            if self._pl_step >= len(self._pl_steps):
                self._phase0_solve_xu()
                return
            item = self._pl_steps[self._pl_step]
            if len(item) == 3 and isinstance(item[0], np.ndarray) and item[0].shape == (3, 3):
                # Cartesian: (R, t, label)
                R, t, label = item
                if not self._move_to_pose(R, t, label):
                    self._pl_step += 1
                    self._pl_next()
            else:
                # Joint: (joints, label)
                joints, label = item
                self.get_logger().info(f'  -> {label}')
                self._send_joint_target(joints, label)
        elif self._pl_state in ('PHASE1_MOVE', 'PHASE2_MOVE'):
            if self._pl_step >= len(self._pl_steps):
                (self._phase1_done if self._pl_state == 'PHASE1_MOVE' else self._phase2_done)()
                return
            joints, label = self._pl_steps[self._pl_step]
            self.get_logger().info(f'  -> {label}')
            self._send_joint_target(joints, label)

    def _phase0_solve_xu(self):
        self.get_logger().info('\n' + '=' * 50 + '\n  Phase 0: Xu Closed-Form Solver\n' + '=' * 50)

        # Collect all Phase 0 records (including anchor)
        all_recs = self.records
        if len(all_recs) < 4:
            self.get_logger().error(f'  too few records: {len(all_recs)}')
            return

        # Build groups by rotation similarity (cluster by R_BH)
        # A frame belongs to group A/B/C if its R_BH is close enough
        def ang_dist(Ra, Rb):
            Rd = Ra.T @ Rb
            tr = np.clip((np.trace(Rd)-1)/2, -1, 1)
            return np.rad2deg(np.arccos(tr))

        # Collect frames with valid e1
        valid_frames = []
        for rec in all_recs:
            if rec.get('valid_e1') and 'p_S_e1' in rec:
                valid_frames.append(rec)

        if len(valid_frames) < 4:
            self.get_logger().error(f'  too few valid e1 frames: {len(valid_frames)}')
            return

        # Greedy clustering: group frames with angular distance < 2°
        groups = []
        used = set()
        for i, rec in enumerate(valid_frames):
            if i in used:
                continue
            group = [(rec['R_BH'], rec['t_BH'], rec['p_S_e1'])]
            used.add(i)
            for j in range(i+1, len(valid_frames)):
                if j in used:
                    continue
                if ang_dist(rec['R_BH'], valid_frames[j]['R_BH']) < 2.0:
                    group.append((valid_frames[j]['R_BH'], valid_frames[j]['t_BH'],
                                  valid_frames[j]['p_S_e1']))
                    used.add(j)
            groups.append(group)

        self.get_logger().info(f'  Clustered into {len(groups)} groups: ' +
                               ' '.join(f'G{i}={len(g)}' for i, g in enumerate(groups)))
        if len(groups) < 2:
            self.get_logger().error('  need ≥2 rotation groups')
            return

        # Import solver
        sys.path.insert(0, '/workspace/Num2')
        from phase0_xu_solver import solve_rotation_xu, solve_translation_xu, estimate_board_from_Rhe

        # Step 1: Solve R_he (using e1 points, edge along u_B)
        group_list = [g for g in groups if len(g) >= 2]
        R_he_est, ok = solve_rotation_xu(group_list, verbose=True)
        if not ok:
            self.get_logger().error('  Xu rotation solver failed')
            return

        err_R = np.rad2deg(np.linalg.norm(so3_log(R_he_est.T @ self.R_he_true)))
        err_R_gt = np.rad2deg(np.linalg.norm(so3_log(R_he_est.T @ self.R_he_gt)))
        self.get_logger().info(f'  R_he_est vs R_he_true: {err_R:.2f}deg')
        self.get_logger().info(f'  R_he_est vs R_he_gt:   {err_R_gt:.2f}deg')

        # Step 2: Estimate board from R_he_est
        all_recs = self.records
        u_B, v_B, n_B = estimate_board_from_Rhe(all_recs, R_he_est, verbose=True)
        if u_B is not None:
            self.n_B_est = n_B
            self.u_B_est = u_B
            self.v_B_est = v_B
            # GT comparison
            n_err = np.rad2deg(np.arccos(np.clip(abs(np.dot(n_B, [0,0,1])), -1, 1)))
            self.get_logger().info(f'  n_B vs GT: {n_err:.2f}deg')
        else:
            self.get_logger().warn('  board estimation failed, using GT')
            self.n_B_est = np.array([0., 0., 1.])
            self.u_B_est = np.array([1., 0., 0.])
            self.v_B_est = np.array([0., 1., 0.])

        # Step 3: Solve t_he
        t_he_est, ok_t = solve_translation_xu(group_list, R_he_est, verbose=True)
        if ok_t:
            err_t = np.linalg.norm(t_he_est - self.t_he_true) * 1000
            self.get_logger().info(f'  t_he_est vs t_he_true: {err_t:.2f}mm')
            # Store improved estimates for later phases
            self.R_he_xu = R_he_est
            self.t_he_xu = t_he_est
        else:
            self.get_logger().warn('  Xu translation solver failed, using nominal')
            self.R_he_xu = R_he_est
            self.t_he_xu = self.t_he_nom

        self.get_logger().info('\n' + '=' * 50)
        self.get_logger().info(f'  Phase 0 complete: R_err={err_R:.2f}deg t_err={err_t:.2f}mm')
        self.get_logger().info('=' * 50)

        # Proceed to Phase 1/2
        self._start_phase1()

    def _start_phase1(self):
        self.get_logger().info('\n' + '-' * 50 + '\n  Phase 1/2: joint perturbations\n' + '-' * 50)
        J0 = self._anchor_joints.copy()
        targets = [
            (J0 + np.array([0., 0., 0., 0., 0.15, 0.]), 'J5+9'),
            (J0 + np.array([0., 0., 0., 0., -0.15, 0.]), 'J5-9'),
            (J0 + np.array([0., 0.10, 0., 0., 0., 0.]), 'J2+6'),
            (J0 + np.array([0., -0.10, 0., 0., 0., 0.]), 'J2-6'),
        ]
        self._pl_steps = [(j, label) for j, label in targets]
        self._pl_step = 0
        self._pl_state = 'PHASE1_MOVE'

    def _phase1_done(self):
        self.get_logger().info('  Phase 1 done')
        self._phase2_done()

    def _phase2_done(self):
        self.get_logger().info('  Phase 2 done')
        self._phase3_solve()

    def _phase3_solve(self):
        self.get_logger().info('\n' + '=' * 50 + '\n  Phase 3: Diagnostics\n' + '=' * 50)
        self._pl_state = 'DONE'
        self._auto_phase = None

        valid_recs = [r for r in self.records if 'R_BH' in r and r.get('n_pts', 0) >= 10]
        self.get_logger().info(f'  total frames: {len(valid_recs)}')
        for i, r in enumerate(valid_recs):
            self.get_logger().info(
                f'    [{i}] n_pts={r["n_pts"]:3d} e1={r.get("valid_e1",False)} e2={r.get("valid_e2",False)}')

        # Diagnostic: compute R_he from each frame and check consistency
        self.get_logger().info('\n  --- R_he per frame diagnostic ---')
        R_he_list = []
        for i, r in enumerate(valid_recs):
            R_BH = r['R_BH']
            R_BS = r.get('R_BS')
            if R_BS is None:
                self.get_logger().warn(f'  [{i}] no R_BS, skipping')
                continue
            R_he_i = R_BH.T @ R_BS
            R_he_list.append(R_he_i)
            err_vs_true = np.rad2deg(np.linalg.norm(so3_log(R_he_i.T @ self.R_he_true)))
            self.get_logger().info(f'  [{i}] R_he_i vs R_he_true: {err_vs_true:.2f}deg')

        if len(R_he_list) >= 2:
            # Check spread
            max_diff = 0
            for i in range(len(R_he_list)):
                for j in range(i+1, len(R_he_list)):
                    Rd = R_he_list[i].T @ R_he_list[j]
                    tr = np.clip((np.trace(Rd)-1)/2, -1, 1)
                    d = np.rad2deg(np.arccos(tr))
                    if d > max_diff: max_diff = d
            self.get_logger().info(f'  Max spread between R_he estimates: {max_diff:.2f}deg')
            # Average
            w_avg = np.mean([so3_log(R) for R in R_he_list], axis=0)
            R_he_avg = so3_exp(w_avg)
            err_avg = np.rad2deg(np.linalg.norm(so3_log(R_he_avg.T @ self.R_he_true)))
            self.get_logger().info(f'  R_he_avg vs R_he_true: R_err={err_avg:.2f}deg')

        # Solver with correct edge assignment
        self.get_logger().info('\n  --- Solver (corrected edge assignment) ---')

        # Classify each frame: is sensor X closer to u_B or v_B?
        meas_corrected = []
        for r in valid_recs:
            # Compute sensor X direction in world
            R_BS = r.get('R_BS')
            if R_BS is None:
                R_BS = r['R_BH'] @ self.R_he_true
            x_S = R_BS[:, 0]  # sensor X axis in world

            dot_u = abs(np.dot(x_S, U_B_GT))
            dot_v = abs(np.dot(x_S, V_B_GT))

            m = {'p_S_plane': list(r.get('pts_S', []))}
            if r.get('valid_e1') and r.get('valid_e2') and 'p_S_e1' in r and 'p_S_e2' in r:
                if dot_u > dot_v:
                    # Sensor X closer to u_B → laser line ~u_B → edges on v_B → both are e2
                    m['valid_e1'] = False
                    m['valid_e2'] = True
                    # Use BOTH edge points — they're on the same v_B edge but at different positions
                    # Store them as two separate e2 measurements
                    m['_p_S_e2_second'] = r['p_S_e2']
                    m['p_S_e2'] = r['p_S_e1']
                    self.get_logger().info(f'    sensor X~u_B → both edges→e2 (2pts)')
                else:
                    m['valid_e1'] = True
                    m['valid_e2'] = False
                    m['_p_S_e1_second'] = r['p_S_e2']
                    m['p_S_e1'] = r['p_S_e1']
                    self.get_logger().info(f'    sensor X~v_B → both edges→e1 (2pts)')
            else:
                m['valid_e1'] = r.get('valid_e1', False)
                m['valid_e2'] = r.get('valid_e2', False)
                m['p_S_e1'] = r.get('p_S_e1')
                m['p_S_e2'] = r.get('p_S_e2')
            meas_corrected.append(m)

        poses = [(r['R_BH'], r['t_BH']) for r in valid_recs]
        n_e1 = sum(1 for m in meas_corrected if m['valid_e1'])
        n_e2 = sum(1 for m in meas_corrected if m['valid_e2'])

        # Custom 6-DOF solver: fix R_pl=I, optimize R_he(3)+t_he(3) only
        self.get_logger().info('\n  --- 6-DOF Solver (fixed R_pl=I) ---')
        self.get_logger().info(f'  corrected: e1={n_e1} e2={n_e2}')

        sys.path.insert(0, '/workspace/Num2')
        from nbv_edge_plane import combined_residuals

        # DIAGNOSTIC: cost at R_he_true vs R_he_gt (both with R_pl=I)
        for label, Rh, th in [("R_he_true", self.R_he_true, self.t_he_true),
                               ("R_he_gt", self.R_he_gt, self.t_he_gt)]:
            w = so3_log(Rh)
            t9 = np.concatenate([w, th, np.zeros(3)])
            r, mask, info = combined_residuals(t9, poses, meas_corrected, 0.1, 1.0)
            rv = r[mask]
            c = 0.5*np.dot(rv, rv) if len(rv) > 0 else 0
            self.get_logger().info(
                f'  Cost@{label}: {c:.6f} (n_plane={info.get("n_plane",0)} '
                f'e1_pairs={info.get("e1_pairs",0)} e2_pairs={info.get("e2_pairs",0)})')
            if len(rv) > 0:
                self.get_logger().info(f'    rms={np.sqrt(np.mean(rv**2)):.6f} max_abs={np.max(np.abs(rv)):.6f}')

        def residuals_6dof(theta6):
            """theta6 = [w_he(3), t_he(3)], R_pl fixed to I"""
            theta9 = np.zeros(9)
            theta9[0:6] = theta6
            theta9[6:9] = 0.0  # R_pl = I
            r, mask, info = combined_residuals(theta9, poses, meas_corrected, 1.0, 0.0)
            return r[mask]

        def cost_6dof(theta6):
            r = residuals_6dof(theta6)
            return 0.5 * np.dot(r, r)

        # Init at R_he_true
        w_init = so3_log(self.R_he_true)
        theta6 = np.concatenate([w_init, self.t_he_true])

        # Simple LM
        lam = 1e-4
        for it in range(30):
            r0 = residuals_6dof(theta6)
            cost0 = 0.5 * np.dot(r0, r0)
            # Numerical Jacobian
            eps = 1e-6
            J = np.zeros((len(r0), 6))
            for k in range(6):
                step = np.zeros(6); step[k] = eps
                rp = residuals_6dof(theta6 + step)
                rm = residuals_6dof(theta6 - step)
                J[:, k] = (rp - rm) / (2 * eps)
            H = J.T @ J + lam * np.eye(6)
            g = J.T @ r0
            try:
                delta = -np.linalg.solve(H, g)
            except np.linalg.LinAlgError:
                lam *= 10; continue
            theta_new = theta6 + delta
            cost_new = cost_6dof(theta_new)
            if cost_new < cost0:
                theta6 = theta_new
                lam = max(lam / 3, 1e-10)
                if abs(cost0 - cost_new) < 1e-12:
                    break
            else:
                lam = min(lam * 3, 1e8)

        Re = so3_exp(theta6[0:3]); te = theta6[3:6]
        Rd = Re.T @ self.R_he_true
        tr = np.clip((np.trace(Rd)-1)/2, -1, 1)
        self.get_logger().info(f'  6DOF vs R_he_true: R_err={np.rad2deg(np.arccos(tr)):.4f}deg t_err={np.linalg.norm(te-self.t_he_true)*1000:.2f}mm')
        Rd2 = Re.T @ self.R_he_gt
        tr2 = np.clip((np.trace(Rd2)-1)/2, -1, 1)
        self.get_logger().info(f'  6DOF vs R_he_gt:   R_err={np.rad2deg(np.arccos(tr2)):.4f}deg t_err={np.linalg.norm(te-self.t_he_gt)*1000:.2f}mm')

        if self._auto_mode:
            diag = [{'R_BH': r['R_BH'].tolist(), 't_BH': r['t_BH'].tolist(),
                     'R_BS': r.get('R_BS', np.eye(3)).tolist() if r.get('R_BS') is not None else None}
                    for r in valid_recs]
            with open('/tmp/auto_calib_diag.json', 'w') as f:
                json.dump(diag, f, indent=2)
            self.get_logger().info('  saved')


def main():
    import argparse
    p = argparse.ArgumentParser()
    p.add_argument('--auto', action='store_true')
    args, _ = p.parse_known_args()
    rclpy.init()
    node = AutoCalibV2Node()
    if args.auto:
        node.create_timer(1.0, node._auto_start_once)
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == '__main__':
    main()
