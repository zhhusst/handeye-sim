<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypesetns="G"?>
<package format="3">
  <name>handeye_sim_bridge</name>
  <version>0.1.0</version>
  <description>双边角点主动手眼标定核心算法与 ROS 2 仿真适配</description>
  <maintainer email="z@z.com">Zhang HaHa</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>action_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>interactive_markers</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>handeye_calibration_core</depend>
  <depend>fanuc_m20id25_support</depend>
  <exec_depend>handeye_sim_backend</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
