               <rdf:li xml:lang="x-default">Final version submitted to IEEE Transactions on Robotics February 10, 2016 15:50:41 PST</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Simultaneous Hand-Eye, Tool-Flange, and Robot-Robot Calibration for Co-manipulation by Solving AXB = YCZ Problem</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:format>application/postscript</dc:format>
